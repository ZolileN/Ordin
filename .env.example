# Database
# Option A — local Docker (recommended): run `docker compose up -d` first
DATABASE_URL="postgresql://ordin:ordin@localhost:5432/ordin?schema=public"
# Option B — Neon/cloud Postgres: paste your connection string from the provider dashboard
# DATABASE_URL="postgresql://user:pass@host.neon.tech/neondb?sslmode=require"

# Auth
AUTH_SECRET="generate-a-secure-random-string-here"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage (local filesystem for MVP; swap for S3/R2 in production)
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./uploads"
# STORAGE_S3_BUCKET=""
# STORAGE_S3_REGION=""
# STORAGE_S3_ACCESS_KEY=""
# STORAGE_S3_SECRET_KEY=""

# Stripe (optional for MVP)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
